# Copy to .env and fill in. .env is gitignored.

# Polygon.io — Stocks Advanced (subscribe Week 1)
POLYGON_API_KEY=
POLYGON_BASE_URL=https://api.polygon.io

# Finnhub — earnings calendar (free tier)
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# Shared provider request timeout
HTTP_TIMEOUT_SECONDS=30

# Alpaca — paper trading (Phase 6)
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# MLflow tracking server
MLFLOW_TRACKING_URI=http://localhost:5000

# DuckDB / data lake root (point to local SSD or VPS volume)
DATA_LAKE_ROOT=./data

# Optional — research-helper LLM API
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
